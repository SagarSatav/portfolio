# Gemini (or swap later) — never commit real keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Paths (relative to this service unless absolute)
# From backend/ai → repo knowledge/
KNOWLEDGE_ROOT=../../knowledge
CHROMA_DIR=./chroma_db
PORT=8000

# Optional: shared secret so only backend/api can call AI
RAG_SERVICE_TOKEN=
